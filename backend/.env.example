# Local cloud testing uses Application Default Credentials:
#   gcloud auth application-default login
# Leave GOOGLE_APPLICATION_CREDENTIALS unset. Cloud Run uses its attached
# runtime service account automatically, so no JSON key is required or allowed.
GCP_PROJECT_ID="intern-bnmit-july-2026"
GCP_LOCATION="us-central1"
ENABLE_LLM="true"
GEMINI_MODEL="gemini-2.5-flash"
WORKER_POLL_SECONDS="10"
FEEOPS_REVIEWER_EMAIL=""
FEEOPS_REVIEWER_PASSWORD=""
